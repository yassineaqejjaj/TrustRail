# Copy to infra/.env and fill in real values before running
# `docker compose -f infra/docker-compose.yml --env-file infra/.env up --build`.
# This is separate from the repo root's `.env` (used by `pnpm setup:local`/`dev`,
# which manage their own local Postgres) -- Compose reads only this file.

# Superuser password for the throwaway postgres:18-alpine container this
# compose file starts. Any strong random value; only used inside the
# compose network.
POSTGRES_SUPERUSER_PASSWORD=

# Passwords for the two application-level Postgres roles the `migrate`
# service creates (schema owner vs RLS-restricted runtime role). See
# docs/ARCHITECTURE.md for why there are two.
TRUSTRAIL_MIGRATOR_PASSWORD=
TRUSTRAIL_APP_PASSWORD=

# Shared secret the gateway (`api`) presents to `merchant-sandbox`'s
# internal write API. Generate with e.g. `openssl rand -hex 24`.
GATEWAY_SHARED_SECRET=

# local | demo | production. demo enables the seedable Demo Lab endpoints;
# production disables them. See docs/OPERATIONS.md before ever setting
# production here.
APP_MODE=demo

# Must match wherever `web` is actually served from, or browser requests
# to the API will be rejected by CORS.
CORS_ORIGIN=http://localhost:3000

# Baked into the web image at build time (Next.js public env var) -- the
# URL a browser will use to reach `api`. Rebuild `web` if this changes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
