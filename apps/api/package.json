{
  "name": "@trustrail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured for api'",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:generate": "drizzle-kit generate",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork=true"
  },
  "dependencies": {
    "@trustrail/contracts": "workspace:*",
    "@trustrail/policy-engine": "workspace:*",
    "@trustrail/receipt-verifier": "workspace:*",
    "fastify": "^5.1.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/sensible": "^6.0.1",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1",
    "argon2": "^0.41.1",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
