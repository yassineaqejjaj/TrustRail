{
  "name": "@trustrail/mcp-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "trustrail-mcp": "./dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured for mcp-adapter'",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork=true"
  },
  "dependencies": {
    "@trustrail/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@trustrail/db": "workspace:*",
    "@trustrail/test-support": "workspace:*",
    "@trustrail/receipt-verifier": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
