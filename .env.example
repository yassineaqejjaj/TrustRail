# Copy to .env and run `pnpm setup:local` to fill in generated values.
# `pnpm setup:local` creates this file for you with safe local secrets; it
# will never overwrite a value that is already set. No entry in this file
# is a real credential -- see docs/PRODUCT_SPEC.md section 18.

NODE_ENV=development
# local | demo | production. Only local/demo allow open registration and
# the demo reset/seed endpoints. Never set production without also
# reviewing docs/OPERATIONS.md and docs/THREAT_MODEL.md.
APP_MODE=local

# --- TrustRail API (apps/api) ---
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
RECEIPT_ISSUER=trustrail-local
SIGNING_KEYS_DIR=./infra/keys

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Merchant sandbox (apps/merchant-sandbox) ---
MERCHANT_SANDBOX_PORT=4100
MERCHANT_SANDBOX_URL=http://127.0.0.1:4100
# Shared secret the gateway presents to the merchant sandbox's internal
# write API. Generated by setup:local. Never given to an agent or browser.
GATEWAY_SHARED_SECRET=

# --- Database ---
# Runtime role (RLS-restricted, no BYPASSRLS) -- what the API server uses.
APP_DATABASE_URL=
# Schema-owning role -- used only by `pnpm migrate`, never by a running server.
MIGRATOR_DATABASE_URL=
MERCHANT_DATABASE_URL=
TRUSTRAIL_MIGRATOR_PASSWORD=
TRUSTRAIL_APP_PASSWORD=

# --- Docker Compose only (infra/docker-compose.yml) ---
# Not used by `pnpm setup:local`/`pnpm dev` (those manage their own local
# Postgres). Required if you run `docker compose -f infra/docker-compose.yml up`.
POSTGRES_SUPERUSER_PASSWORD=
